# Copy this file to .env and fill in your keys:  cp .env.example .env
# Only OPENAI_API_KEY is required. Leave the others empty to skip them.

# OpenAI (required): reads the job description and writes the email
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Pinecone (optional): stores your resume pieces. Without it, search runs in memory.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=cold-email-copilot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Hunter.io (optional): finds the recruiter's email. Without it, you type it yourself.
HUNTER_API_KEY=

# n8n (optional): sends the email for you. Without it, use "Open in Gmail".
N8N_WEBHOOK_URL=
